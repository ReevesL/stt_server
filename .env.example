HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Number of CPU threads for Whisper (CTranslate2) and PyTorch (diarization).
# Default 14. Above ~18 risks CTranslate2 crashes and heavy CPU heat.
OMP_NUM_THREADS=14

# Number of concurrent transcription jobs. Each job uses OMP_NUM_THREADS threads,
# so MAX_WORKERS * OMP_NUM_THREADS should not exceed your core count.
MAX_WORKERS=1

# Whisper model. large-v3-turbo (default) is much faster; large-v3 is slightly more accurate.
WHISPER_MODEL=large-v3-turbo
